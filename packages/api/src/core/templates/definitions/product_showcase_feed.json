{
  "template_id": "product_showcase_feed",
  "name": "Product Showcase Feed Post",
  "format": "feed_post",
  "intent": ["sales", "conversions"],
  "pillars": ["product", "promotion"],
  "platforms": ["instagram", "facebook", "pinterest"],
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "slides": [
    {
      "slot_id": "slide_1",
      "slot_type": "product_showcase",
      "layout": "centered_product_with_details",
      "components": [
        {
          "type": "background",
          "position": { "x": 0, "y": 0, "width": 100, "height": 100, "z_index": 1 },
          "overlay": false
        },
        {
          "type": "image",
          "position": { "x": 10, "y": 15, "width": 80, "height": 50, "z_index": 2 },
          "required_aspect_ratio": "16:10",
          "min_width": 864,
          "min_height": 540,
          "overlay": false
        },
        {
          "type": "headline",
          "position": { "x": 10, "y": 70, "width": 50, "height": 10, "z_index": 2 },
          "max_chars": 40,
          "overlay": false
        },
        {
          "type": "body",
          "position": { "x": 10, "y": 82, "width": 50, "height": 13, "z_index": 2 },
          "max_chars": 120,
          "overlay": false
        },
        {
          "type": "cta_button",
          "position": { "x": 65, "y": 72, "width": 25, "height": 10, "z_index": 2 },
          "max_chars": 20,
          "overlay": false
        },
        {
          "type": "logo",
          "position": { "x": 80, "y": 5, "width": 10, "height": 5, "z_index": 2 },
          "overlay": true
        }
      ]
    }
  ]
}
