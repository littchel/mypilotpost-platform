  "format": "feed_post",
  "intent": ["engagement", "authority"],
  "pillars": ["values", "thought_leadership"],
  "platforms": ["instagram", "linkedin", "twitter"],
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "slides": [
    {
      "slot_id": "slide_1",
