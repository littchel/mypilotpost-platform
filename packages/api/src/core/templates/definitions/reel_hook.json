{
  "template_id": "reel_hook",
  "name": "Hook and CTA Reel Template",
  "format": "reel",
  "intent": ["awareness", "leads"],
  "pillars": ["video", "engagement"],
  "platforms": ["instagram", "tiktok", "youtube"],
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "animation_preset": "reveal",
  "slides": [
    {
      "slot_id": "hook_segment",
      "slot_type": "hero",
      "layout": "hook_overlay_3s",
      "components": [
        { "type": "background", "position": { "x": 0, "y": 0, "width": 100, "height": 100, "z_index": 1 }, "overlay": false },
        { "type": "headline", "position": { "x": 10, "y": 40, "width": 80, "height": 20, "z_index": 2 }, "max_chars": 50, "overlay": true },
        { "type": "logo", "position": { "x": 10, "y": 5, "width": 15, "height": 4, "z_index": 2 }, "overlay": true }
      ]
    },
    {
      "slot_id": "main_segment",
      "slot_type": "body",
      "layout": "main_content_7s",
      "components": [
        { "type": "background", "position": { "x": 0, "y": 0, "width": 100, "height": 100, "z_index": 1 }, "overlay": false },
        { "type": "body", "position": { "x": 10, "y": 30, "width": 80, "height": 40, "z_index": 2 }, "max_chars": 150, "overlay": true },
        { "type": "logo", "position": { "x": 10, "y": 5, "width": 15, "height": 4, "z_index": 2 }, "overlay": true }
      ]
    },
    {
      "slot_id": "cta_segment",
      "slot_type": "cta",
      "layout": "cta_close_5s",
      "components": [
        { "type": "background", "position": { "x": 0, "y": 0, "width": 100, "height": 100, "z_index": 1 }, "overlay": false },
        { "type": "headline", "position": { "x": 10, "y": 35, "width": 80, "height": 15, "z_index": 2 }, "max_chars": 50, "overlay": true },
        { "type": "cta_button", "position": { "x": 30, "y": 60, "width": 40, "height": 8, "z_index": 2 }, "max_chars": 20, "overlay": true },
        { "type": "logo", "position": { "x": 42.5, "y": 5, "width": 15, "height": 4, "z_index": 2 }, "overlay": true }
      ]
    }
  ]
}
