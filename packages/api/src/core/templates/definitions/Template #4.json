{
  "template_id": "product_showcase_feed",
  "format": "Feed Post (1:1)",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "layout_structure": {
    "top_zone": {
      "height": "594px",
      "percentage": "55%",
      "background": "#FFFFFF",
      "components": {
        "badge_header": {
          "text": "BEST SELLER",
          "font_family": "Inter, sans-serif",
          "font_size": "40px",
          "letter_spacing": "24px"
        },
        "image_frame": {
          "max_width": "600px",
          "height": "430px",
          "background_color": "#000000",
          "content_key": "product_image_url"
        }
      }
    },
    "bottom_zone": {
      "height": "486px",
      "percentage": "45%",
      "background": "#FFFFFF",
      "components": {
        "product_name": {
          "text": "PRIMADONNA",
          "font_family": "{{brand.font_headline}}",
          "font_size": "38px",
          "letter_spacing": "16px",
          "color": "{{brand.primary_color}}"
        },
        "feature_bullets": {
          "max_items": 3,
          "max_lines_per_item": 2,
          "font_family": "{{brand.font_body}}",
          "font_size": "16px",
          "color": "#333333",
          "items": [
            "Exquisite notes of dark amber, rich plum, and crisp midnight jasmine flora.",
            "Long-lasting luxury formulation engineered to adapt beautifully to your natural chemistry."
          ]
        },
        "cta_button": {
          "text": "Learn More",
          "font_family": "{{brand.font_body}}",
          "font_size": "18px",
          "font_weight": "600",
          "background_color": "{{brand.primary_color}}",
          "text_color": "#FFFFFF",
          "padding": "14px 45px",
          "border_radius": "50px"
        }
      }
    },
    "background_accents": {
      "horizontal_strip": {
        "top": "350px",
        "height": "300px",
        "color": "{{brand.secondary_color}}"
      },
      "side_url": {
        "text": "www.reallygreatsite.com",
        "font_size": "24px",
        "letter_spacing": "2px",
        "color": "#FFFFFF",
        "rotation": "-90deg"
      }
    }
  },
  "content_data": {
    "product_image_url": "https://images.unsplash.com/photo-1541643600914-78b084683601"
  }
}