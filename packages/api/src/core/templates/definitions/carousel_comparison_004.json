{
  "carousel_id": "comparison_carousel_template_8_v2",
  "format": "Carousels (Multi-Slide, 1:1 Square)",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "transition_style": "Slide Left (smooth)",
  "brand_defaults": {
    "primary_color": "#153223",
    "accent_color": "#D6743E",
    "text_color_primary": "#FFFFFF"
  },
  "slides": [
    {
      "slide_index": 1,
      "type": "cover_title",
      "components": {
        "brand_seal": {
          "type": "svg_crest",
          "text_labels": [
            "BREWSMITH",
            "ROASTERY"
          ]
        },
        "comparison_headers": {
          "top_text": "ARABICA",
          "divider_text": "VS",
          "bottom_text": "ROBUSTA"
        },
        "action_cta": {
          "text": "Which One is for You?",
          "style": {
            "border_radius": "60px",
            "margin_bottom": "20px"
          }
        }
      }
    },
    {
      "slide_index": 2,
      "type": "single_feature_showcase",
      "content": {
        "title": "ARABICA",
        "sub_header": "Grown at High Altitude\n(1,000–2,000 MASL)\nSofter & Sweeter Taste",
        "circle_image_url": "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd",
        "footer_notes": "Fruity, Floral, Chocolatey\nLess Caffeine (≈1.2%)"
      }
    },
    {
      "slide_index": 3,
      "type": "single_feature_showcase",
      "content": {
        "title": "ROBUSTA",
        "sub_header": "Grown at Lower Altitude\n(sea level–800 MASL)\nStrong, Bold, Bitter flavor",
        "circle_image_url": "https://images.unsplash.com/photo-1511920170033-f8396924c348",
        "footer_notes": "Earthy, Nutty, Woody\nHigher Caffeine (≈2.2%)"
      },
      "layout_rules": {
        "image_aspect_ratio": "1:1",
        "shape": "perfect_circle"
      }
    },
    {
      "slide_index": 4,
      "type": "quick_compare_split",
      "content": {
        "section_header": "Quick Compare",
        "capsule_image_url": "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd",
        "left_pill_label": "Arabica",
        "right_pill_label": "Robusta",
        "left_description": "Smooth, Sweet,\nAromatic",
        "right_description": "Strong, Bitter,\nHigher Caffeine"
      },
      "layout_rules": {
        "header_single_line": true,
        "header_alignment": "center"
      }
    },
    {
      "slide_index": 5,
      "type": "selection_matrix",
      "content": {
        "section_header": "Which You Love?",
        "options": [
          {
            "pill_header": "Choose Arabica If:",
            "body_text": "You Love Mild, Sweet, Aromatic Coffee"
          },
          {
            "pill_header": "Choose Robusta If:",
            "body_text": "You Want a Bold, Intense Flavor\nwith a Caffeine Kick"
          }
        ]
      },
      "layout_rules": {
        "header_single_line": true,
        "header_alignment": "center"
      }
    },
    {
      "slide_index": 6,
      "type": "closing_cta",
      "content": {
        "section_header": "Follow Us!",
        "brand_seal_large": {
          "type": "svg_crest",
          "text_labels": [
            "BREWSMITH",
            "COFFEE ROASTERS"
          ]
        },
        "social_handle_pill": {
          "text": "@reallygreatsite",
          "url": "#"
        }
      }
    }
  ],
  "template_id": "carousel_comparison_004"
}