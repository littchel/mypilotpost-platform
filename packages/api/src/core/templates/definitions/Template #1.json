{
  "template_id": "editorial_dual_font_cover",
  "format": "feed_post",
  "dimensions": { "width": 1080, "height": 1350 },
  "slots": [
    {
      "slot_id": "media_background",
      "type": "image",
      "z_index": 0,
      "content_key": "image_url",
      "x": "0%", "y": "0%", "width": "100%", "height": "100%"
    },
    {
      "slot_id": "legibility_banner",
      "type": "shape",
      "z_index": 1,
      "x": "0%", "y": "70%", "width": "100%", "height": "30%",
      "fill": "brand.secondary_color",
      "opacity": 0.55,
      "radius": 0
    },
    {
      "slot_id": "boxed_pre_headline",
      "type": "text",
      "z_index": 2,
      "content_key": "pre_headline",
      "text": "HOW TO FIND YOUR",
      "font": "brand.body_font",
      "weight": 500,
      "size": 24,
      "color": "brand.contrast_on_dark",
      "align": "center",
      "max_chars": 30,
      "x": "30%", "y": "38%", "width": "40%", "height": "6%",
      "border": { "width": "2px", "color": "brand.primary_color", "radius": "8px" }
    },
    {
      "slot_id": "massive_serif_title",
      "type": "text",
      "z_index": 2,
      "content_key": "headline",
      "text": "style",
      "font": "brand.heading_font",
      "weight": 400,
      "style": "italic",
      "size": 120,
      "max_chars": 24,
      "color": "brand.contrast_on_dark",
      "align": "center",
      "x": "10%", "y": "44%", "width": "80%", "height": "25%"
    },
    {
      "slot_id": "cta_pill",
      "type": "cta_button",
      "z_index": 3,
      "content_key": "cta",
      "text": "Learn More",
      "max_chars": 20,
      "font": "brand.body_font",
      "fill": "brand.accent_color",
      "text_color": "brand.contrast_on_accent",
      "radius": 8,
      "x": "35%", "y": "80%", "width": "30%", "height": "6%"
    },
    {
      "slot_id": "brand_logo",
      "type": "logo",
      "z_index": 4,
      "source": "brand.logo_url",
      "x": "80%", "y": "4%", "width": "12%", "height": "6%"
    },
    {
      "slot_id": "brand_handle_footer",
      "type": "text",
      "z_index": 2,
      "content_key": "handle",
      "text": "@ reallygreatsite",
      "font": "brand.body_font",
      "weight": 400,
      "size": 18,
      "color": "brand.contrast_on_dark",
      "align": "center",
      "max_chars": 40,
      "x": "20%", "y": "92%", "width": "60%", "height": "4%"
    }
  ]
}